# Copy this to .env and fill in your values
# Docker-compose uses this file for configuration

# Database connection
SHOWLIST_DB_CONNECTION=Server=db;Database=showlist2026;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;
DB_SA_PASSWORD=YourStrong!Passw0rd

# Paths (mapped as volumes in docker-compose)
Showlist__TvNameListPath=/tvnamelist/
Showlist__ShowFolderBasePath=/tv_name_list/
Showlist__TvMazeBaseUrl=http://api.tvmaze.com

# Notifications (all optional)
Notifications__Pushover__Enabled=false
Notifications__Pushover__ApiKey=
Notifications__Pushover__UserKey=
Notifications__Discord__Enabled=false
Notifications__Discord__WebhookUrl=
Notifications__Email__Enabled=false
Notifications__Email__SmtpHost=
Notifications__Email__SmtpPort=587
Notifications__Email__From=
Notifications__Email__To=
Notifications__Email__Username=
Notifications__Email__Password=
