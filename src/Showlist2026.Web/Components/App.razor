<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Showlist2026.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#0d6efd" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="apple-touch-icon" href="icon.svg" />
    <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'light');</script>
    <style>
        #global-loading-bar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            z-index: 99999;
            pointer-events: none;
            background: transparent;
            display: none;
        }
        #global-loading-bar.active {
            display: block;
        }
        #global-loading-bar::after {
            content: '';
            display: block;
            height: 100%;
            width: 30%;
            background: linear-gradient(90deg, #0d6efd, #0dcaf0, #0d6efd);
            animation: loading-slide 0.8s ease-in-out infinite;
        }
        @@keyframes loading-slide {
            0% { margin-left: -30%; }
            100% { margin-left: 100%; }
        }
    </style>
</head>

<body>
    <div id="global-loading-bar"></div>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script>
        (function () {
            var bar = document.getElementById('global-loading-bar');

            document.addEventListener('click', function (e) {
                // Internal links
                var link = e.target.closest('a[href]');
                if (link && !link.target && link.href.startsWith(window.location.origin)) {
                    bar.classList.add('active');
                    return;
                }
                // Buttons and action icons
                var btn = e.target.closest('button, [role="button"], i.far, i.fas');
                if (btn) {
                    bar.classList.add('active');
                }
            });

            // Hide when Blazor finishes DOM updates
            new MutationObserver(function () {
                if (bar.classList.contains('active')) {
                    clearTimeout(window._lbTimeout);
                    window._lbTimeout = setTimeout(function () {
                        bar.classList.remove('active');
                    }, 200);
                }
            }).observe(document.body, { childList: true, subtree: true });
        })();

        // Dark mode
        (function () {
            var theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
            updateIcon(theme);

            window.toggleDarkMode = function () {
                var current = document.documentElement.getAttribute('data-theme') || 'light';
                var next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
                updateIcon(next);
            };

            function updateIcon(t) {
                var icon = document.getElementById('dark-mode-icon');
                if (icon) {
                    icon.className = t === 'dark' ? 'fas fa-sun' : 'fas fa-moon';
                }
            }

            // Re-apply after Blazor re-renders the layout
            new MutationObserver(function () {
                var t = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-theme', t);
                updateIcon(t);
            }).observe(document.body, { childList: true });
        })();
    </script>
    <script>
        // Popover system using event delegation — no MutationObserver, no re-init loops
        (function () {
            var activePopover = null;
            var activeTrigger = null;
            var hideTimer = null;
            var showTimer = null;

            function clearTimers() {
                clearTimeout(hideTimer);
                clearTimeout(showTimer);
            }

            function hideActive() {
                clearTimers();
                if (activePopover) {
                    activePopover.hide();
                    activePopover.dispose();
                    activePopover = null;
                    activeTrigger = null;
                }
            }

            function scheduleHide() {
                clearTimeout(hideTimer);
                hideTimer = setTimeout(hideActive, 400);
            }

            // Delegate mouseenter on popover trigger elements
            document.addEventListener('mouseover', function (e) {
                var trigger = e.target.closest('[data-bs-toggle="popover"]');
                if (!trigger) return;

                // Already showing for this trigger
                if (trigger === activeTrigger) {
                    clearTimers();
                    return;
                }

                clearTimers();

                // Hide any existing popover immediately
                if (activePopover) {
                    activePopover.hide();
                    activePopover.dispose();
                    activePopover = null;
                    activeTrigger = null;
                }

                showTimer = setTimeout(function () {
                    if (!document.body.contains(trigger)) return;
                    activeTrigger = trigger;
                    activePopover = new bootstrap.Popover(trigger, {
                        sanitize: false,
                        container: 'body',
                        trigger: 'manual',
                        html: true
                    });
                    activePopover.show();
                }, 300);
            });

            // Delegate mouseleave — schedule hide
            document.addEventListener('mouseout', function (e) {
                var trigger = e.target.closest('[data-bs-toggle="popover"]');
                if (trigger && trigger === activeTrigger) {
                    // Check if moving to the popover tip
                    var related = e.relatedTarget;
                    if (related && related.closest('.popover')) return;
                    scheduleHide();
                }
            });

            // Keep popover alive while hovering over it
            document.addEventListener('mouseover', function (e) {
                if (e.target.closest('.popover') && activePopover) {
                    clearTimers();
                }
            });

            document.addEventListener('mouseout', function (e) {
                if (e.target.closest('.popover')) {
                    var related = e.relatedTarget;
                    if (related && (related.closest('.popover') || related === activeTrigger || (activeTrigger && activeTrigger.contains(related)))) return;
                    scheduleHide();
                }
            });

            // Dismiss on click outside
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.popover') && !e.target.closest('[data-bs-toggle="popover"]')) {
                    hideActive();
                }
            });

            // Clean up on Blazor navigation
            document.addEventListener('blazor:enhancedload', function () {
                hideActive();
            });
        })();
    </script>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js');
        }
    </script>
    <script>
        // Clipboard copy: uses client-side click handler to stay in user gesture context
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-copy]');
            if (!btn) return;
            e.preventDefault();
            e.stopPropagation();
            var text = btn.getAttribute('data-copy');
            if (!text) return;
            // Try modern API first
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(function () {
                    showCopyFeedback(btn);
                }, function () {
                    fallbackCopy(text, btn);
                });
            } else {
                fallbackCopy(text, btn);
            }
        });
        function fallbackCopy(text, btn) {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.cssText = 'position:fixed;left:0;top:0;opacity:0';
            document.body.appendChild(ta);
            ta.focus();
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            showCopyFeedback(btn);
        }
        function showCopyFeedback(btn) {
            var orig = btn.className;
            btn.className = 'fas fa-check text-success';
            setTimeout(function () { btn.className = orig; }, 1500);
        }
    </script>
</body>

</html>
