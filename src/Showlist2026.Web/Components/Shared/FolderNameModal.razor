@if (Show != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Save Folder Name</h5>
                    <button type="button" class="btn-close" @onclick="Cancel" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3 row">
                        <label class="col-md-3 col-form-label">Folder</label>
                        <div class="col-md-9">
                            <input type="text" class="form-control"
                                   @bind="folderName"
                                   maxlength="255" minlength="2" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveFolderName">Save</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Show Show { get; set; }
    [Parameter] public EventCallback<(long id, string name)> OnFolderNameChanged { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string folderName;

    protected override void OnParametersSet()
    {
        folderName = Show?.FolderName ?? Show?.SuggestedFolderName ?? Show?.DefaultFolderName;
    }

    private async Task SaveFolderName()
    {
        if (!string.IsNullOrWhiteSpace(folderName) && Show != null)
        {
            await OnFolderNameChanged.InvokeAsync((Show.Id, folderName));
        }
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}
