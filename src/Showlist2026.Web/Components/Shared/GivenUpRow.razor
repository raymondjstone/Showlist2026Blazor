@if (Episode?.ep != null)
{
    @* ── Desktop layout (hidden on mobile) ── *@
    <div class="row d-none d-md-flex">
        <div class="col-1">
            @if (Episode.ep.AirDateOffset2 != null)
            {
                <i title="@(((DateTimeOffset)Episode.ep.AiringTime).LocalDateTime.ToString("HH:mm"))">
                    @(((DateTimeOffset)Episode.ep.AiringTime).LocalDateTime.Date.ToString("dd MMM yyyy"))
                </i>
            }
        </div>
        <div class="col-2">
            <FilterButtons Model="@Episode.showFilter" OnFilterChanged="OnFilterChanged" />
            <a href="/showlist/show/@Episode.ep.show.Id" target="_blank"
               data-bs-toggle="popover" data-bs-html="true" data-bs-content="@Episode.ep.show.summarycleanwithimage">
                @Episode.ep.show.name
            </a>
        </div>
        <div class="col-2">
            <i class="fas fa-undo text-success" title="Undo given up" role="button"
               @onclick="() => OnUndoGivenUp.InvokeAsync((Episode.ep.Id, false))"></i>
            @(Episode.ep.EpNumberFormatted)
            <a href="#" data-bs-toggle="popover" data-bs-html="true" data-bs-content="@Episode.ep.summarycleanwithimage">@Episode.ep.name</a>
        </div>
        <div class="col-1">
            @if (Episode.ep.show.Languages != null)
            {
                <FilterButtons Model="@Episode.languageFilter" OnFilterChanged="OnFilterChanged" />
                @Episode.ep.show.Languages.name
            }
        </div>
        <div class="col-2">
            @if (Episode.ep.show.Networks != null && !string.IsNullOrEmpty(Episode.ep.show.Networks.name))
            {
                <FilterButtons Model="@Episode.networkFilter" OnFilterChanged="OnFilterChanged" />
                @Episode.ep.show.Networks.name
                @if (Episode.ep.show.Networks.country != null && Episode.ep.show.Networks.country.code != "??")
                {
                    <text> (</text>
                    <FilterButtons Model="@Episode.countryFilter(Episode.ep.show.Networks.country.Id, null)" OnFilterChanged="OnFilterChanged" />
                    @(Episode.ep.show.Networks.country.code + ")")
                }
            }
            @if (Episode.ep.show.WebNetworks != null && !string.IsNullOrEmpty(Episode.ep.show.WebNetworks.name))
            {
                @if (Episode.ep.show.Networks != null && !string.IsNullOrEmpty(Episode.ep.show.Networks.name))
                {
                    <br />
                }
                <FilterButtons Model="@Episode.webnetworkFilter" OnFilterChanged="OnFilterChanged" />
                @Episode.ep.show.WebNetworks.name
                @if (Episode.ep.show.WebNetworks.country != null && Episode.ep.show.WebNetworks.country.code != "??")
                {
                    <text> (</text>
                    <FilterButtons Model="@Episode.countryFilter(Episode.ep.show.WebNetworks.country.Id, null)" OnFilterChanged="OnFilterChanged" />
                    @(Episode.ep.show.WebNetworks.country.code + ")")
                }
            }
        </div>
        <div class="col-2">
            @if (Episode.ep.show.Genres != null)
            {
                var first = true;
                foreach (var g in Episode.ep.show.Genres)
                {
                    if (!first)
                    {
                        <br />
                    }
                    <FilterButtons Model="@Episode.genreFilter(g.genretext.Id, null)" OnFilterChanged="OnFilterChanged" />
                    @g.genretext.genre
                    first = false;
                }
            }
        </div>
        <div class="col-1">
            @{
                var statusClass = Episode.ep.show.status?.ToLower() switch
                {
                    "running" => "bg-success",
                    "ended" => "bg-secondary",
                    "to be determined" => "bg-warning text-dark",
                    "in development" => "bg-info",
                    _ => "bg-light text-dark"
                };
            }
            <span class="badge @statusClass">@Episode.ep.show.status</span>
        </div>
        <div class="col-1">
            @if (Episode.ep.show.Types != null)
            {
                <FilterButtons Model="@Episode.typeFilter" OnFilterChanged="OnFilterChanged" />
                @Episode.ep.show.Types.type
            }
        </div>
    </div>

    @* ── Mobile card layout (hidden on desktop) ── *@
    <div class="d-md-none card card-body p-2 mb-2">
        <div class="d-flex justify-content-between align-items-start">
            <div class="flex-grow-1">
                <div class="d-flex align-items-center gap-1 mb-1">
                    <FilterButtons Model="@Episode.showFilter" OnFilterChanged="OnFilterChanged" />
                    <a href="/showlist/show/@Episode.ep.show.Id" target="_blank" class="fw-bold">
                        @Episode.ep.show.name
                    </a>
                    @{
                        var mobileStatusClass = Episode.ep.show.status?.ToLower() switch
                        {
                            "running" => "bg-success",
                            "ended" => "bg-secondary",
                            "to be determined" => "bg-warning text-dark",
                            "in development" => "bg-info",
                            _ => "bg-light text-dark"
                        };
                    }
                    <span class="badge @mobileStatusClass ms-1" style="font-size:0.65rem;">@Episode.ep.show.status</span>
                </div>
                <div class="d-flex align-items-center gap-2 small">
                    <i class="fas fa-undo text-success" title="Undo given up" role="button"
                       @onclick="() => OnUndoGivenUp.InvokeAsync((Episode.ep.Id, false))"></i>
                    <span class="fw-semibold">@Episode.ep.EpNumberFormatted</span>
                    <span class="text-muted">@Episode.ep.name</span>
                </div>
                <div class="text-muted small mt-1">
                    @if (Episode.ep.AirDateOffset2 != null)
                    {
                        @(((DateTimeOffset)Episode.ep.AiringTime).LocalDateTime.Date.ToString("dd MMM yyyy"))
                        <text> &middot; </text>
                    }
                    @if (Episode.ep.show.Networks != null && !string.IsNullOrEmpty(Episode.ep.show.Networks.name))
                    {
                        @Episode.ep.show.Networks.name
                    }
                    @if (Episode.ep.show.WebNetworks != null && !string.IsNullOrEmpty(Episode.ep.show.WebNetworks.name))
                    {
                        @if (Episode.ep.show.Networks != null && !string.IsNullOrEmpty(Episode.ep.show.Networks.name))
                        {
                            <text> / </text>
                        }
                        @Episode.ep.show.WebNetworks.name
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EpFilter Episode { get; set; }
    [Parameter] public EventCallback<(long id, string type, bool? state)> OnFilterChanged { get; set; }
    [Parameter] public EventCallback<(long id, bool state)> OnUndoGivenUp { get; set; }
}
