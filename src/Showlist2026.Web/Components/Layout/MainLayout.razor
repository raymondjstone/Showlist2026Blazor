@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="d-flex" style="min-height: 100vh;" id="app-root">
    <!-- Desktop sidebar -->
    <div class="d-none d-md-flex">
        <NavMenu />
    </div>

    <!-- Mobile offcanvas sidebar -->
    <div class="offcanvas offcanvas-start bg-dark text-white d-md-none" tabindex="-1" id="mobileNav">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title">
                <i class="fas fa-tv me-2"></i> Showlist
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <NavMenu />
        </div>
    </div>

    <main class="flex-grow-1 p-3" style="overflow-x: auto;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <button class="btn btn-outline-secondary d-md-none" type="button"
                    data-bs-toggle="offcanvas" data-bs-target="#mobileNav">
                <i class="fas fa-bars"></i>
            </button>
            <div class="ms-auto">
                <button id="dark-mode-toggle" class="btn btn-sm btn-outline-secondary" title="Toggle dark mode" onclick="toggleDarkMode()">
                    <i id="dark-mode-icon" class="fas fa-moon"></i>
                </button>
            </div>
        </div>
        @Body
    </main>
</div>

<!-- Mobile bottom navigation -->
<div class="mobile-bottom-nav d-md-none">
    <div class="d-flex justify-content-around text-center">
        <a href="/" class="d-flex flex-column align-items-center">
            <i class="fas fa-home"></i>
            <span>Home</span>
        </a>
        <a href="/airing" class="d-flex flex-column align-items-center">
            <i class="fas fa-calendar-day"></i>
            <span>Airing</span>
        </a>
        <a href="/unwatched" class="d-flex flex-column align-items-center">
            <i class="fas fa-eye-slash"></i>
            <span>Unwatched</span>
        </a>
        <a href="/coming-soon" class="d-flex flex-column align-items-center">
            <i class="fas fa-star"></i>
            <span>Soon</span>
        </a>
        <a href="/search" class="d-flex flex-column align-items-center">
            <i class="fas fa-search"></i>
            <span>Search</span>
        </a>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet style="display:none;">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try
        {
            await JS.InvokeVoidAsync("eval",
                "var el = document.getElementById('mobileNav'); if (el) { var oc = bootstrap.Offcanvas.getInstance(el); if (oc) oc.hide(); }");
        }
        catch { }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
