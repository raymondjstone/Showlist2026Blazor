@page "/watched-history"
@rendermode InteractiveServer
@inject IShowListAppService AppService

<PageTitle>Watch History</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Recently Watched</h4>
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 small">Days:</label>
            <select class="form-select form-select-sm" style="width:auto" @onchange="OnDaysChanged">
                <option value="7">7</option>
                <option value="30" selected>30</option>
                <option value="90">90</option>
                <option value="365">365</option>
            </select>
        </div>
    </div>

    @if (history == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!history.Any())
    {
        <p class="text-muted">No watched episodes in this period.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Show</th>
                        <th>Episode</th>
                        <th>Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in history)
                    {
                        <tr>
                            <td>@h.WatchedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @if (h.episode?.show != null)
                                {
                                    <a href="/showlist/show/@h.episode.show.Id">@h.episode.show.name</a>
                                }
                            </td>
                            <td>@h.episode?.EpNumberFormatted</td>
                            <td>@h.episode?.name</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Showlist2026.Entities.WatchedHistory> history;
    private int days = 30;

    protected override async Task OnInitializedAsync()
    {
        LoadHistory();
    }

    private void OnDaysChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var d))
        {
            days = d;
            LoadHistory();
        }
    }

    private void LoadHistory()
    {
        history = AppService.GetWatchedHistory(days);
    }
}
