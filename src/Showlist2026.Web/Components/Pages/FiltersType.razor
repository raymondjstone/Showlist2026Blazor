@page "/filters/types"
@rendermode InteractiveServer
@inject IShowListAppService AppService

<PageTitle>Type Filters</PageTitle>

@if (types == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <h4>Type Filters</h4>
        <br />
        @foreach (var i in types)
        {
            <div class="row mb-1">
                <div class="col-4">
                    @i.type
                    @if (string.IsNullOrEmpty(i.type))
                    {
                        <text>{No type specified}</text>
                    }
                </div>
                @if (i.UserTypeSelections == null || i.UserTypeSelections.Count == 0)
                {
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always include show if the type is @i.type"
                                @onclick="() => SetFilter(i.Id, true)">
                            Always Include
                        </button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always exclude show if the type is @i.type"
                                @onclick="() => SetFilter(i.Id, false)">
                            Always Exclude
                        </button>
                    </div>
                }
                else if (i.UserTypeSelections.First().include)
                {
                    <div class="col-3">
                        <button class="btn btn-success btn-sm" title="Click to remove the always included filter"
                                @onclick="() => DeleteFilter(i.Id)">
                            Always included
                        </button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always exclude show if the type is @i.type"
                                @onclick="() => SetFilter(i.Id, false)">
                            Always Exclude
                        </button>
                    </div>
                }
                else
                {
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always include show if the type is @i.type"
                                @onclick="() => SetFilter(i.Id, true)">
                            Always Include
                        </button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-danger btn-sm" title="Click to remove the always excluded filter"
                                @onclick="() => DeleteFilter(i.Id)">
                            Always Excluded
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Showlist2026.Entities.Type> types;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        types = AppService.TypeData().OrderBy(a => a.type).ToList();
    }

    private async Task SetFilter(int id, bool stateWanted)
    {
        await AppService.TypeFilter(id, stateWanted);
        await LoadData();
    }

    private async Task DeleteFilter(int id)
    {
        await AppService.TypeFilter(id, null);
        await LoadData();
    }
}
