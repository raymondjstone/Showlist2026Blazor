@page "/calendar"
@rendermode InteractiveServer
@inject IShowListAppService AppService

<PageTitle>Calendar</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-1">
            <button class="btn btn-outline-secondary" @onclick="Previous">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="btn btn-outline-secondary" @onclick="GoToToday">Today</button>
            <button class="btn btn-outline-secondary" @onclick="Next">
                <i class="fas fa-chevron-right"></i>
            </button>
            <input type="date" class="form-control form-control-sm ms-2" style="width:auto;"
                   value="@jumpDate.ToString("yyyy-MM-dd")"
                   @onchange="HandleJumpDate" />
        </div>
        <h4 class="mb-0">
            @if (viewMode == "month")
            {
                @currentDate.ToString("MMMM yyyy")
            }
            else
            {
                var weekEnd = weekStart.AddDays(6);
                @($"{weekStart:dd MMM} – {weekEnd:dd MMM yyyy}")
            }
        </h4>
        <div class="btn-group">
            <button class="btn @(viewMode == "week" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetView("week")'>Week</button>
            <button class="btn @(viewMode == "month" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetView("month")'>Month</button>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center"><div class="spinner-border" role="status"></div></div>
    }
    else if (viewMode == "month")
    {
        @* ── Month View ── *@
        <div class="row fw-bold text-center border-bottom pb-2 mb-0 bg-dark text-white rounded-top">
            @foreach (var day in dayHeaders)
            {
                <div class="col py-1">@day</div>
            }
        </div>

        @foreach (var week in weeks)
        {
            <div class="row border-start border-end" style="min-height: 110px;">
                @foreach (var day in week)
                {
                    var isToday = day.Date == today;
                    var isCurrentMonth = day.Month == currentDate.Month;
                    var dayClasses = !isCurrentMonth ? "text-muted calendar-day-outside" : "calendar-day";
                    <div class="col p-1 border-bottom border-end @dayClasses @(isToday ? "calendar-today" : "")">
                        <div class="fw-bold small @(isToday ? "text-primary" : "")">@day.Day</div>
                        @if (episodesByDate.TryGetValue(day.Date, out var dayEps))
                        {
                            @foreach (var ep in dayEps.Take(4))
                            {
                                var bgClass = GetEpisodeBgClass(ep);
                                <a href="/showlist/show/@ep.ep.show.Id"
                                   class="d-block text-truncate text-white rounded px-1 mb-1 text-decoration-none @bgClass"
                                   style="font-size: 0.7rem;"
                                   data-bs-toggle="popover" data-bs-html="true"
                                   data-bs-content="@ep.ep.show.summarycleanwithimage">
                                    @ep.ep.show?.nameclean @ep.ep.EpNumberFormatted
                                </a>
                            }
                            @if (dayEps.Count > 4)
                            {
                                <button class="btn btn-link p-0 text-muted" style="font-size: 0.65rem;"
                                        @onclick="() => ShowDayDetail(day.Date, dayEps)">
                                    +@(dayEps.Count - 4) more
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        }
    }
    else
    {
        @* ── Week View ── *@
        <div class="row fw-bold text-center border-bottom pb-2 mb-0 bg-dark text-white rounded-top">
            @for (int i = 0; i < 7; i++)
            {
                var d = weekStart.AddDays(i);
                var isToday = d.Date == today;
                <div class="col py-1 @(isToday ? "bg-primary rounded" : "")">
                    @d.ToString("ddd dd")
                </div>
            }
        </div>

        <div class="row border-start border-end" style="min-height: 500px;">
            @for (int i = 0; i < 7; i++)
            {
                var d = weekStart.AddDays(i);
                var isToday = d.Date == today;
                <div class="col p-2 border-bottom border-end @(isToday ? "calendar-today" : "")">
                    @if (episodesByDate.TryGetValue(d.Date, out var dayEps))
                    {
                        @foreach (var ep in dayEps)
                        {
                            var bgClass = GetEpisodeBgClass(ep);
                            <a href="/showlist/show/@ep.ep.show.Id"
                               class="d-block text-white rounded px-2 py-1 mb-1 text-decoration-none @bgClass"
                               style="font-size: 0.8rem;"
                               data-bs-toggle="popover" data-bs-html="true"
                               data-bs-content="@ep.ep.show.summarycleanwithimage">
                                <strong>@ep.ep.show?.nameclean</strong><br />
                                <span style="font-size:0.7rem;">
                                    @ep.ep.EpNumberFormatted
                                    @if (!string.IsNullOrEmpty(ep.ep.name)) { <text> – @ep.ep.name</text> }
                                    @if (!string.IsNullOrEmpty(ep.ep.airtime)) { <text> &nbsp; @ep.ep.airtime</text> }
                                </span>
                            </a>
                        }
                    }
                    else
                    {
                        <span class="text-muted small fst-italic">No episodes</span>
                    }
                </div>
            }
        </div>
    }

    @* ── Day Detail Modal ── *@
    @if (selectedDayEps != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);" @onclick="CloseDayDetail">
            <div class="modal-dialog" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@selectedDay?.ToString("dddd, dd MMMM yyyy")</h5>
                        <button type="button" class="btn-close" @onclick="CloseDayDetail"></button>
                    </div>
                    <div class="modal-body" style="max-height:400px;overflow-y:auto;">
                        @foreach (var ep in selectedDayEps)
                        {
                            var bgClass = GetEpisodeBgClass(ep);
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge @bgClass me-2">@ep.ep.EpNumberFormatted</span>
                                <div>
                                    <a href="/showlist/show/@ep.ep.show.Id">@ep.ep.show?.name</a>
                                    @if (!string.IsNullOrEmpty(ep.ep.name))
                                    {
                                        <br /><small class="text-muted">@ep.ep.name</small>
                                    }
                                    @if (!string.IsNullOrEmpty(ep.ep.airtime))
                                    {
                                        <small class="text-muted ms-1">@ep.ep.airtime</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── Legend ── *@
    <div class="d-flex gap-3 mt-3 small">
        <span><span class="badge cal-wanted">&nbsp;&nbsp;</span> Wanted</span>
        <span><span class="badge cal-undecided">&nbsp;&nbsp;</span> Undecided</span>
        <span><span class="badge cal-watched">&nbsp;&nbsp;</span> Watched</span>
    </div>
</div>

<style>
    .calendar-day-outside {
        background-color: #f8f9fa;
    }
    .calendar-today {
        background-color: rgba(13, 110, 253, 0.08) !important;
    }
    [data-theme="dark"] .calendar-day-outside {
        background-color: #1a1d20;
    }
    [data-theme="dark"] .calendar-today {
        background-color: rgba(13, 110, 253, 0.15) !important;
    }
    .cal-wanted { background-color: #198754; color: #fff; }
    .cal-undecided { background-color: #e67e22; color: #fff; }
    .cal-ignored { background-color: #6c757d; color: #fff; }
    .cal-watched { background-color: #b0c4b0; color: #555; opacity: 0.7; }
</style>

@code {
    private static readonly string[] dayHeaders = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    private DateTimeOffset currentDate = DateTimeOffset.Now;
    private DateTime today = DateTime.Now.Date;
    private DateTimeOffset weekStart;
    private List<EpFilter> episodes = new();
    private Dictionary<DateTime, List<EpFilter>> episodesByDate = new();
    private List<List<DateTimeOffset>> weeks = new();
    private bool loading = true;
    private string viewMode = "week";
    private DateTime jumpDate = DateTime.Now.Date;

    // Day detail modal
    private List<EpFilter>? selectedDayEps;
    private DateTime? selectedDay;

    protected override async Task OnInitializedAsync()
    {
        weekStart = GetMonday(DateTimeOffset.Now);
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        StateHasChanged();

        DateTimeOffset rangeStart, rangeEnd;

        if (viewMode == "month")
        {
            var firstOfMonth = new DateTimeOffset(currentDate.Year, currentDate.Month, 1, 0, 0, 0, TimeSpan.Zero);
            rangeStart = firstOfMonth.AddDays(-7);
            rangeEnd = firstOfMonth.AddMonths(1).AddDays(7);
        }
        else
        {
            rangeStart = weekStart;
            rangeEnd = weekStart.AddDays(7);
        }

        int daysMinus = (int)(rangeStart - DateTimeOffset.UtcNow).TotalDays;
        int daysPlus = (int)(rangeEnd - DateTimeOffset.UtcNow).TotalDays;

        episodes = AppService.AiringAroundNowForUser(daysMinus, daysPlus, includeWatched: true);

        episodesByDate = episodes
            .Where(e => e.ep?.AiringTime != null && e.ep.AiringTime != DateTimeOffset.MinValue)
            .GroupBy(e => e.ep.AiringTime.Date)
            .ToDictionary(g => g.Key, g => g
                .OrderBy(e => e.ep.airtime ?? "")
                .ThenBy(e => e.ep.show?.name ?? "")
                .ThenBy(e => e.ep.season ?? 0)
                .ThenBy(e => e.ep.number ?? 0)
                .ToList());

        if (viewMode == "month")
            BuildWeeks();

        loading = false;
    }

    private void BuildWeeks()
    {
        weeks = new List<List<DateTimeOffset>>();
        var firstOfMonth = new DateTimeOffset(currentDate.Year, currentDate.Month, 1, 0, 0, 0, TimeSpan.Zero);
        int daysToMonday = ((int)firstOfMonth.DayOfWeek + 6) % 7;
        var start = firstOfMonth.AddDays(-daysToMonday);

        for (int w = 0; w < 6; w++)
        {
            var week = new List<DateTimeOffset>();
            for (int d = 0; d < 7; d++)
                week.Add(start.AddDays(w * 7 + d));
            if (week[0].Month != currentDate.Month && week[6].Month != currentDate.Month)
                break;
            weeks.Add(week);
        }
    }

    private async Task Previous()
    {
        if (viewMode == "month")
            currentDate = currentDate.AddMonths(-1);
        else
            weekStart = weekStart.AddDays(-7);
        await LoadData();
    }

    private async Task HandleJumpDate(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var date))
        {
            jumpDate = date;
            currentDate = new DateTimeOffset(date, TimeSpan.Zero);
            weekStart = GetMonday(currentDate);
            await LoadData();
        }
    }

    private async Task Next()
    {
        if (viewMode == "month")
            currentDate = currentDate.AddMonths(1);
        else
            weekStart = weekStart.AddDays(7);
        await LoadData();
    }

    private async Task GoToToday()
    {
        currentDate = DateTimeOffset.Now;
        weekStart = GetMonday(DateTimeOffset.Now);
        await LoadData();
    }

    private async Task SetView(string mode)
    {
        viewMode = mode;
        if (mode == "week")
            weekStart = GetMonday(currentDate);
        await LoadData();
    }

    private static DateTimeOffset GetMonday(DateTimeOffset date)
    {
        int diff = ((int)date.DayOfWeek + 6) % 7;
        return date.AddDays(-diff).Date;
    }

    private static string GetEpisodeBgClass(EpFilter ep)
    {
        if (ep.activelywatched) return "cal-watched";
        if (ep.Activelyselected) return "cal-wanted";
        if (ep.Activelyignored) return "cal-ignored";
        return "cal-undecided";
    }

    private void ShowDayDetail(DateTime date, List<EpFilter> eps)
    {
        selectedDay = date;
        selectedDayEps = eps;
    }

    private void CloseDayDetail()
    {
        selectedDayEps = null;
        selectedDay = null;
    }
}
