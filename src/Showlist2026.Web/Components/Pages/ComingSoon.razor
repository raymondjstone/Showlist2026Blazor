@page "/coming-soon"
@rendermode InteractiveServer
@inject IShowListAppService AppService

<PageTitle>Coming Soon</PageTitle>

@if (showList == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h4>Coming Soon (@filteredList.Count shows)</h4>
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 small">Status:</label>
                <select class="form-select form-select-sm" style="width:auto" @onchange="OnStatusFilterChanged">
                    <option value="All">All</option>
                    <option value="Running">Running</option>
                    <option value="Ended">Ended</option>
                    <option value="To Be Determined">TBD</option>
                    <option value="In Development">In Development</option>
                </select>
            </div>
        </div>
        @foreach (var s in filteredList)
        {
            @if (s.ep != null)
            {
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-3">
                                            <img src="@s.ep.imagemed" class="img-fluid" />
                                        </div>
                                        <div class="col-9">
                                            <h5>
                                                <a href="/showlist/show/@s.ep.Id">@s.ep.name</a>
                                                @{
                                                    var statusClass = s.ep.status?.ToLower() switch
                                                    {
                                                        "running" => "bg-success",
                                                        "ended" => "bg-secondary",
                                                        "to be determined" => "bg-warning text-dark",
                                                        "in development" => "bg-info",
                                                        _ => "bg-light text-dark"
                                                    };
                                                }
                                                <span class="badge @statusClass ms-2">@s.ep.status</span>
                                                @if (s.ep.ShowStart > DateTime.MinValue)
                                                {
                                                    <span class="badge bg-dark ms-2">@s.ep.ShowStart.ToString("dd MMM yyyy")</span>
                                                }
                                            </h5>
                                            @if (s.ep.Types != null)
                                            {
                                                @s.ep.Types.type
                                                <br />
                                            }
                                            @if (s.ep.Languages != null)
                                            {
                                                @s.ep.Languages.name
                                                <br />
                                            }
                                            @if (s.ep.Networks != null && !string.IsNullOrEmpty(s.ep.Networks.name))
                                            {
                                                @s.ep.Networks.name
                                                <br />
                                            }
                                            @if (s.ep.WebNetworks != null && !string.IsNullOrEmpty(s.ep.WebNetworks.name))
                                            {
                                                @s.ep.WebNetworks.name
                                                <br />
                                            }
                                            @if (episodeCounts != null && episodeCounts.ContainsKey(s.ep.Id))
                                            {
                                                var counts = episodeCounts[s.ep.Id];
                                                <span class="badge bg-primary">@counts.watched / @counts.total watched</span>
                                                <br />
                                            }
                                            @if (s.ep.summary != null)
                                            {
                                                @((MarkupString)s.ep.summaryclean)
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}

@code {
    private List<ShowFilter> showList;
    private List<ShowFilter> filteredList;
    private string statusFilter = "All";
    private Dictionary<int, (int watched, int total)> episodeCounts;

    protected override async Task OnInitializedAsync()
    {
        showList = AppService.ComingSoonForUser()
            .OrderBy(a => a.ep.name).ToList();

        var showIds = showList.Where(s => s.ep != null).Select(s => s.ep.Id).ToList();
        episodeCounts = AppService.GetEpisodeCountsForShows(showIds);

        ApplyFilter();
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? "All";
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (statusFilter == "All")
            filteredList = showList;
        else
            filteredList = showList.Where(s => s.ep != null &&
                string.Equals(s.ep.status, statusFilter, StringComparison.OrdinalIgnoreCase)).ToList();
    }
}
