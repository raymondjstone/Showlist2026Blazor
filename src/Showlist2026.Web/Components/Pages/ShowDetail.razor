@page "/showlist/show/{ShowId:long}"
@rendermode InteractiveServer
@inject IShowListAppService AppService
@using Showlist2026.NZBPlanetApiJSON

<PageTitle>@(show?.name ?? "Show")</PageTitle>

@if (show == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="row">
            <div class="col-4">
                <img src="@show.imagemed" class="img-fluid" />
            </div>
            <div class="col-8">
                <h2>
                    <FilterButtons Model="@ShowFilter.showFilter" OnFilterChanged="HandleFilterChanged" />
                    <a href="https://www.tvmaze.com/shows/@show.showid">@show.name</a>
                    @if (!string.IsNullOrEmpty(show.regexp))
                    {
                        <a href="#" data-copy="@show.regexp" class="ms-2 text-muted" title="Copy regex to clipboard">
                            <i class="fas fa-clipboard fa-sm"></i>
                        </a>
                    }
                </h2>
                <br />
                Folder - @(show.FolderName ?? $"{show.SuggestedFolderName ?? show.DefaultFolderName} [default]")
                @if (folderAliases != null && folderAliases.Any())
                {
                    <br />
                    <small class="text-muted">
                        Aliases:
                        @foreach (var alias in folderAliases)
                        {
                            <span class="badge bg-secondary me-1">
                                @alias.AliasName
                                <i class="fas fa-times ms-1" role="button" title="Remove alias"
                                   @onclick="() => RemoveAlias(alias.Id)"></i>
                            </span>
                        }
                    </small>
                }
                <div class="float-end">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => showAliasInput = !showAliasInput" title="Add folder alias">
                        <i class="fas fa-folder-plus"></i> Alias
                    </button>
                    <button class="btn btn-primary btn-sm" @onclick="() => showFolderModal = true">
                        <i class="fa fa-plus-square"></i> Set Folder Name
                    </button>
                    <button class="btn btn-success btn-sm ms-1" @onclick="CatchUp" disabled="@catchingUp">
                        @if (catchingUp) { <span class="spinner-border spinner-border-sm"></span> }
                        <i class="fas fa-forward"></i> Catch Up
                    </button>
                    <button class="btn btn-danger btn-sm ms-1" @onclick="GiveUp" disabled="@givingUp">
                        @if (givingUp) { <span class="spinner-border spinner-border-sm"></span> }
                        <i class="fas fa-flag"></i> Give Up
                    </button>
                </div>
                @if (showAliasInput)
                {
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <input type="text" class="form-control form-control-sm" style="max-width:300px;"
                               @bind="newAliasName" placeholder="Alias folder name" />
                        <button class="btn btn-sm btn-success" @onclick="AddAlias">Add</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => showAliasInput = false">Cancel</button>
                    </div>
                }
                <br />

                @if (show.Types != null)
                {
                    <FilterButtons Model="@ShowFilter.typeFilter" OnFilterChanged="HandleFilterChanged" />
                    @(" ")@show.Types.type
                    <br />
                }
                @if (show.Genres != null)
                {
                    foreach (var g in show.Genres)
                    {
                        <FilterButtons Model="@ShowFilter.genreFilter(g.Id, g?.genretext?.Wanted)" OnFilterChanged="HandleFilterChanged" />
                        @(g.genretext.genre + ", ")
                    }
                    <br />
                }
                @if (show.Languages != null)
                {
                    <FilterButtons Model="@ShowFilter.languageFilter" OnFilterChanged="HandleFilterChanged" />
                    @show.Languages.name
                    <br />
                }
                @if (show.Networks != null && !string.IsNullOrEmpty(show.Networks.name))
                {
                    <FilterButtons Model="@ShowFilter.networkFilter" OnFilterChanged="HandleFilterChanged" />
                    @show.Networks.name
                    @if (show.Networks.country != null && show.Networks.country.code != "??")
                    {
                        <text> (</text>
                        <FilterButtons Model="@ShowFilter.countryFilter(show.Networks.country.Id, null)" OnFilterChanged="HandleFilterChanged" />
                        @(" " + show.Networks.country.code + ")")
                    }
                    <br />
                }
                @if (show.WebNetworks != null && !string.IsNullOrEmpty(show.WebNetworks.name))
                {
                    <FilterButtons Model="@ShowFilter.webnetworkFilter" OnFilterChanged="HandleFilterChanged" />
                    @show.WebNetworks.name
                    @if (show.WebNetworks.country != null && show.WebNetworks.country.code != "??")
                    {
                        <text> (</text>
                        <FilterButtons Model="@ShowFilter.countryFilter(show.WebNetworks.country.Id, null)" OnFilterChanged="HandleFilterChanged" />
                        @(" " + show.WebNetworks.country.code + ")")
                    }
                    <br />
                }
                @if (show.summary != null)
                {
                    @((MarkupString)show.summaryclean)
                }
                <br />

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Priority</label>
                        <select class="form-select form-select-sm" value="@showPriority" @onchange="OnPriorityChanged">
                            <option value="0">None</option>
                            <option value="1">Low</option>
                            <option value="2">Medium</option>
                            <option value="3">High</option>
                        </select>
                    </div>
                </div>

                <div class="mt-2">
                    <label class="form-label fw-bold">Notes</label>
                    <textarea class="form-control form-control-sm" rows="3" @bind="showNotes"></textarea>
                    <button class="btn btn-sm btn-outline-primary mt-1" @onclick="SaveNotes">Save Notes</button>
                    @if (notesSaved)
                    {
                        <span class="text-success ms-2 small">Saved</span>
                    }
                </div>

                @if (showWithSameName.Count > 0)
                {
                    <b>Shows that this show may get confused with:</b>
                    foreach (var sd in showWithSameName)
                    {
                        <br />
                        <a href="/showlist/show/@sd.Id" target="_blank">@sd.name [@(sd.FolderName ?? sd.DefaultFolderName)]</a>
                    }
                }
            </div>
        </div>

        <br />

        @if (nextEpisode != null)
        {
            <div class="row">
                <div class="col-6"><b>Next Episode</b></div>
            </div>
            @* ── Desktop next episode (hidden on mobile) ── *@
            <div class="row fw-bold d-none d-md-flex">
                <div class="col-1">Date</div>
                <div class="col-1">Episode</div>
                <div class="col-3">Name</div>
                <div class="col-7">Summary</div>
            </div>
            <div class="row bg-light d-none d-md-flex">
                <div class="col-1">
                    @if (nextEpisode.AirDateOffset2 != null)
                    {
                        @(nextEpisode.AiringTime.Date.ToString("dd MMM yyyy"))
                    }
                </div>
                <div class="col-1">
                    @if (nextEpisode.GivenUp)
                    {
                        <i class="fas fa-flag text-danger" title="Given up — click to undo" role="button"
                           @onclick="() => HandleGivenUpChanged((nextEpisode.Id, false))"></i>
                    }
                    else if (!nextEpisode.Watched)
                    {
                        <i class="far fa-eye" title="Mark as watched" role="button"
                           @onclick="() => HandleWatchedChanged((nextEpisode.Id, true))"></i>
                        <i class="fas fa-flag text-muted ms-1" title="Give up this episode" role="button"
                           @onclick="() => HandleGivenUpChanged((nextEpisode.Id, true))"></i>
                    }
                    else
                    {
                        <i class="fas fa-trash-restore" title="Mark as NOT watched" role="button"
                           @onclick="() => HandleWatchedChanged((nextEpisode.Id, false))"></i>
                    }
                    @(nextEpisode.EpNumberFormatted)
                </div>
                <div class="col-3">@nextEpisode.nameclean</div>
                <div class="col-7">@((MarkupString)nextEpisode.summaryclean)</div>
            </div>

            @* ── Mobile next episode (hidden on desktop) ── *@
            <div class="d-md-none card card-body p-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                    @if (nextEpisode.GivenUp)
                    {
                        <i class="fas fa-flag text-danger" title="Given up — click to undo" role="button"
                           @onclick="() => HandleGivenUpChanged((nextEpisode.Id, false))"></i>
                    }
                    else if (!nextEpisode.Watched)
                    {
                        <i class="far fa-eye" title="Mark as watched" role="button"
                           @onclick="() => HandleWatchedChanged((nextEpisode.Id, true))"></i>
                        <i class="fas fa-flag text-muted ms-1" title="Give up this episode" role="button"
                           @onclick="() => HandleGivenUpChanged((nextEpisode.Id, true))"></i>
                    }
                    else
                    {
                        <i class="fas fa-trash-restore" title="Mark as NOT watched" role="button"
                           @onclick="() => HandleWatchedChanged((nextEpisode.Id, false))"></i>
                    }
                    <span class="fw-semibold">@nextEpisode.EpNumberFormatted</span>
                    <span>@nextEpisode.nameclean</span>
                </div>
                <div class="text-muted small">
                    @if (nextEpisode.AirDateOffset2 != null)
                    {
                        @(nextEpisode.AiringTime.Date.ToString("dd MMM yyyy"))
                    }
                </div>
            </div>
            <br />
        }
    </div>
    <br />

    <div class="container-fluid">
        <ul class="nav nav-tabs flex-wrap" id="seasonTabs" role="tablist">
            @foreach (var tab in Tabs)
            {
                string pref = Tabs.Count < 10 ? "  Season " : "  S";
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(activeSeasonTab == "S" + tab.First().season ? "active" : "")"
                            type="button" role="tab"
                            @onclick="() => SetActiveSeasonTab(tab.First().season)">
                        @(pref + tab.First().season)
                    </button>
                </li>
            }
        </ul>
        <div class="tab-content" id="seasonTabContent">
            @foreach (var tab in Tabs)
            {
                @if (activeSeasonTab == "S" + tab.First().season)
                {
                    <div class="tab-pane fade show active" role="tabpanel">
                        <SeasonTab Episodes="tab" OnWatchedChanged="HandleWatchedChanged" OnGivenUpChanged="HandleGivenUpChanged" OnSeasonWatchedChanged="HandleSeasonWatchedChanged" />
                    </div>
                }
            }
        </div>

        @if (showFolderModal)
        {
            <FolderNameModal Show="show" OnFolderNameChanged="HandleFolderNameChanged" OnCancel="() => showFolderModal = false" />
        }
    </div>

    @if (similarShows != null && similarShows.Any())
    {
        <div class="container-fluid mt-3">
            <h5>Similar Shows</h5>
            <div class="row g-2">
                @foreach (var sim in similarShows)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(sim.imagemed))
                                {
                                    <img src="@sim.imagemed" alt="@sim.name" style="width:80px;height:112px;object-fit:cover;border-radius:4px 0 0 4px;" />
                                }
                                <div class="p-2" style="min-width:0;">
                                    <a href="/showlist/show/@sim.Id" class="small">@sim.name</a>
                                    @if (sim.Networks != null)
                                    {
                                        <br /><small class="text-muted">@sim.Networks.name</small>
                                    }
                                    @if (!string.IsNullOrEmpty(sim.status))
                                    {
                                        <br /><small class="badge bg-secondary">@sim.status</small>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="container-fluid">
        @if (NZBFound?.Channel?.Item != null)
        {
            string lastep = "";
            foreach (var z in NZBFound.Channel.Item)
            {
                if (lastep != z.EpNumberFormatted)
                {
                    lastep = z.EpNumberFormatted;
                    <div class="row">
                        <div class="col-12"><hr /></div>
                    </div>
                }
                <NZBRow Item="z" />
            }
        }
        <hr />
        Alternative searches -
        @if (TvSites != null && TvSites.Any())
        {
            foreach (var z in TvSites.Where(a => a.Active))
            {
                var url = z.URLTemplate
                    .Replace("{URLSearchTerm}", show.URLSearchTerm)
                    .Replace("{URLSearchTermNameOnly}", show.URLSearchTermNameOnly)
                    .Replace("{URLSearchTermGeekSeek}", show.URLSearchTermGeekSeek);
                <a href="@url" target="_blank" class="me-2">@z.Name</a>
            }
        }
        <button class="btn btn-outline-primary btn-sm ms-3" @onclick="CrawlNzbSites" disabled="@isCrawling">
            @if (isCrawling)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            <i class="fas fa-spider"></i> Crawl API
        </button>
        <button class="btn btn-outline-info btn-sm ms-1" @onclick="CrawlRssFeeds" disabled="@isCrawling" title="Crawl RSS feeds (requires RSS API key)">
            @if (isCrawling)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            <i class="fas fa-rss"></i> Crawl RSS
        </button>

        @if (crawlSummary != null)
        {
            <div class="mt-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold">
                        Crawl Results: @crawlSummary.TotalResults found from @crawlSummary.SitesCrawled sites
                    </span>
                    @if (crawlSummary.Results.Any() || crawlSummary.CrawledUrls.Any())
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => crawlSummary = null">
                            <i class="fas fa-times"></i> Clear
                        </button>
                    }
                </div>

                @if (crawlSummary.CrawledUrls.Any())
                {
                    <div class="card mb-3">
                        <div class="card-header py-2">
                            <small class="fw-bold"><i class="fas fa-link"></i> URLs Crawled</small>
                        </div>
                        <div class="card-body p-2">
                            <table class="table table-sm table-bordered mb-0 small">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:120px;">Site</th>
                                        <th>URL</th>
                                        <th style="width:80px;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var crawled in crawlSummary.CrawledUrls)
                                    {
                                        var rowClass = crawled.Success ? "" : "table-warning";
                                        <tr class="@rowClass">
                                            <td class="text-nowrap">@crawled.SiteName</td>
                                            <td class="font-monospace" style="font-size:0.7rem; word-break:break-all;">
                                                <a href="@crawled.Url" target="_blank" title="Open in browser">@crawled.Url</a>
                                            </td>
                                            <td class="text-center">
                                                @if (crawled.Success)
                                                {
                                                                                    <span class="badge bg-success">@crawled.HttpStatus</span>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <span class="badge bg-danger" title="@crawled.ErrorMessage">@(crawled.HttpStatus > 0 ? crawled.HttpStatus.ToString() : "ERR")</span>
                                                                                    }
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    }


                                                    @if (crawlSummary.Results.Any())
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-sm table-striped">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Episode</th>
                                                                        <th>Title</th>
                                                                        <th>Site</th>
                                                                        <th>Size</th>
                                                                        <th>Actions</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                @foreach (var result in crawlSummary.Results)
                                {
                                    <tr>
                                        <td class="text-nowrap fw-semibold">@result.EpisodeCode</td>
                                        <td class="small" style="max-width:400px;" title="@result.Title">
                                            @(result.Title.Length > 60 ? result.Title.Substring(0, 60) + "..." : result.Title)
                                        </td>
                                        <td class="text-nowrap">@result.SiteName</td>
                                        <td class="text-nowrap">@result.Size</td>
                                        <td class="text-nowrap">
                                            @if (!string.IsNullOrEmpty(result.DownloadUrl))
                                            {
                                                <a href="@result.DownloadUrl" target="_blank" class="btn btn-sm btn-outline-success" title="Download">
                                                    <i class="fas fa-download"></i>
                                                </a>
                                            }
                                            <a href="@result.SearchUrl" target="_blank" class="btn btn-sm btn-outline-info" title="Open Search Page">
                                                <i class="fas fa-external-link-alt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (!crawlSummary.Errors.Any())
                {
                    <div class="alert alert-info py-2">No matching NZB links found for unwatched episodes.</div>
                }
                
                @if (crawlSummary.DebugInfo.Any())
                {
                    <div class="card mb-3">
                        <div class="card-header py-2">
                            <small class="fw-bold"><i class="fas fa-bug"></i> Debug Info</small>
                        </div>
                        <div class="card-body p-2">
                            <pre class="mb-0 small" style="max-height:300px; overflow-y:auto; font-size:0.7rem;">@string.Join("\n", crawlSummary.DebugInfo)</pre>
                        </div>
                    </div>
                }

                @if (crawlSummary.Errors.Any())
                {
                    <div class="alert alert-warning py-1 small">
                        <strong>Warnings:</strong> @string.Join("; ", crawlSummary.Errors)
                    </div>
                }

                

            </div>
        }
        <hr />
    </div>
}

@code {
    [Parameter] public long ShowId { get; set; }

    private Show show;
    private List<Show> showWithSameName = new();
    private List<List<Episode>> Tabs = new();
    private Episode nextEpisode;
    private Episode lastEpisode;
    private EpFilter ShowFilter;
    private NzBplanetJSON NZBFound;
    private List<TVSite> TvSites;
    private string activeSeasonTab;
    private bool showFolderModal;
    private bool catchingUp;
    private bool givingUp;
    private string showNotes = "";
    private int showPriority;
    private bool notesSaved;
    private List<Show> similarShows = new();
    private bool isCrawling;
    private NzbSiteCrawlSummary? crawlSummary;
    private List<ShowFolderAlias> folderAliases = new();
    private bool showAliasInput;
    private string newAliasName = "";

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        show = AppService.ShowPageData(ShowId);
        TvSites = AppService.TvSites();

        ShowFilter = new EpFilter(TvSites);

        if (show.Episodes != null && show.Episodes.Count > 0)
            ShowFilter.ep = show.Episodes.FirstOrDefault();

        // Set filter states from Wanted property on entities
        if (show.Wanted != null)
        {
            ShowFilter.showinclude = show.Wanted.Value;
            ShowFilter.Activelyselected = show.Wanted.Value;
            ShowFilter.Activelyignored = !show.Wanted.Value;
        }
        if (show.Types?.Wanted != null)
        {
            ShowFilter.typeinclude = show.Types.Wanted.Value;
            if (show.Types.Wanted.Value) ShowFilter.Activelyselected = true;
            else ShowFilter.Activelyignored = true;
        }
        if (show.Networks?.Wanted != null)
        {
            ShowFilter.networkinclude = show.Networks.Wanted.Value;
            if (show.Networks.Wanted.Value) ShowFilter.Activelyselected = true;
            else ShowFilter.Activelyignored = true;
        }
        if (show.WebNetworks?.Wanted != null)
        {
            ShowFilter.webnetworkinclude = show.WebNetworks.Wanted.Value;
            if (show.WebNetworks.Wanted.Value) ShowFilter.Activelyselected = true;
            else ShowFilter.Activelyignored = true;
        }
        if (show.Languages?.Wanted != null)
        {
            ShowFilter.languageinclude = show.Languages.Wanted.Value;
            if (show.Languages.Wanted.Value) ShowFilter.Activelyselected = true;
            else ShowFilter.Activelyignored = true;
        }
        if (show.Networks?.country?.Wanted != null)
        {
            ShowFilter.countryinclude = show.Networks.country.Wanted.Value;
            if (show.Networks.country.Wanted.Value) ShowFilter.Activelyselected = true;
            else ShowFilter.Activelyignored = true;
        }
        if (show.WebNetworks?.country?.Wanted != null)
        {
            if (ShowFilter.countryinclude == null) ShowFilter.countryinclude = show.WebNetworks.country.Wanted.Value;
            if (show.WebNetworks.country.Wanted.Value) ShowFilter.Activelyselected = true;
            else ShowFilter.Activelyignored = true;
        }
        if (show.Genres != null)
        {
            foreach (var g in show.Genres.Where(a => a.genretext?.Wanted != null))
            {
                if (ShowFilter.genreinclude == null) ShowFilter.genreinclude = g.genretext.Wanted.Value;
                if (g.genretext.Wanted.Value) ShowFilter.Activelyselected = true;
                else ShowFilter.Activelyignored = true;
            }
        }

        // Build season tabs
        Tabs = new List<List<Episode>>();
        lastEpisode = null;
        var episodes = (show.Episodes ?? new List<Episode>()).OrderByDescending(e => e.season).ThenBy(e => e.number);
        nextEpisode = episodes.FirstOrDefault(e => e.AiringTime >= DateTimeOffset.UtcNow);
        if (episodes.Any()) lastEpisode = episodes.Last();

        var tab = new List<Episode>();
        long lastSeason = long.MaxValue;
        foreach (var ep in episodes)
        {
            if (ep.AiringTime <= DateTimeOffset.UtcNow && lastEpisode != null && ep.AiringTime > lastEpisode.AiringTime)
                lastEpisode = ep;
            if (lastSeason > (ep.season ?? 0))
            {
                if (lastSeason < long.MaxValue) Tabs.Add(tab);
                tab = new List<Episode>();
                lastSeason = (ep.season ?? 0);
            }
            tab.Add(ep);
        }
        if (lastSeason < long.MaxValue) Tabs.Add(tab);

        if (activeSeasonTab == null && Tabs.Any())
        {
            activeSeasonTab = "S" + Tabs.First().First().season;
        }

        // NZB search
        try
        {
            if (show.Episodes != null && show.Episodes.Any(f => !f.Watched))
            {
                NZBFound = await AppService.NZBPlanetSearch(show);
                if (NZBFound?.Channel?.Item != null)
                {
                    var unwatched = show.Episodes.Where(f => !f.Watched).Select(f => f.EpNumberFormatted);
                    NZBFound.Channel.Item = NZBFound.Channel.Item
                        .Where(z => unwatched.Any(u => u == z.EpNumberFormatted))
                        .OrderByDescending(e => e.EpNumberFormatted)
                        .ThenBy(e => e.Sortkey)
                        .ThenBy(e => e.SizeAsNumber)
                        .ToList();
                }
            }
        }
        catch { }

        var thisFolder = show.FolderName ?? show.DefaultFolderName;
        showWithSameName = AppService.showlist(show.name)
            .Where(s => s.showid != show.showid &&
                (s.name == show.name
                 || (!string.IsNullOrEmpty(thisFolder) && (s.FolderName ?? s.DefaultFolderName).Equals(thisFolder, StringComparison.OrdinalIgnoreCase))))
            .ToList();

        showNotes = show.Notes ?? "";
        showPriority = show.Priority;
        notesSaved = false;
        try { similarShows = AppService.GetSimilarShows(show.Id, 5); } catch { similarShows = new(); }
        folderAliases = AppService.GetFolderAliases(show.Id);
    }

    private void SetActiveSeasonTab(long? season)
    {
        activeSeasonTab = "S" + (season ?? 0);
    }

    private async Task HandleFilterChanged((long id, string type, bool? state) args)
    {
        switch (args.type.ToLower())
        {
            case "show": await AppService.ShowFilter(args.id, args.state); break;
            case "language": await AppService.LanguageFilter(args.id, args.state); break;
            case "network": await AppService.NetworkFilter(args.id, args.state); break;
            case "webnetwork": await AppService.WebNetworkFilter(args.id, args.state); break;
            case "type": await AppService.TypeFilter(args.id, args.state); break;
            case "genre": await AppService.GenreFilter(args.id, args.state); break;
            case "country": await AppService.CountryFilter(args.id, args.state); break;
        }
        await LoadData();
    }

    private async Task HandleWatchedChanged((long id, bool state) args)
    {
        await AppService.WatchedFilter(args.id, args.state);
        await LoadData();
    }

    private async Task HandleGivenUpChanged((long id, bool state) args)
    {
        await AppService.GivenUpFilter(args.id, args.state);
        await LoadData();
    }

    private async Task HandleSeasonWatchedChanged((long seasonId, long season, bool state) args)
    {
        await AppService.SeasonWatchedFilter(args.seasonId, args.season, args.state);
        await LoadData();
    }

    private async Task HandleFolderNameChanged((long id, string name) args)
    {
        await AppService.SetFolderName(args.id, args.name);
        showFolderModal = false;
        await LoadData();
    }

    private async Task CatchUp()
    {
        catchingUp = true;
        await AppService.CatchUpShow(show.Id);
        catchingUp = false;
        await LoadData();
    }

    private async Task GiveUp()
    {
        givingUp = true;
        await AppService.GiveUpShow(show.Id);
        givingUp = false;
        await LoadData();
    }

    private async Task SaveNotes()
    {
        await AppService.SetShowNotes(show.Id, showNotes);
        notesSaved = true;
    }

    private async Task OnPriorityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pri))
        {
            showPriority = pri;
            await AppService.SetShowPriority(show.Id, pri);
        }
    }

    private async Task CrawlNzbSites()
    {
        isCrawling = true;
        crawlSummary = null;
        StateHasChanged();

        try
        {
            crawlSummary = await AppService.CrawlNzbSitesForShow(show.Id);
        }
        catch (Exception ex)
        {
            crawlSummary = new NzbSiteCrawlSummary();
            crawlSummary.Errors.Add($"Crawl failed: {ex.Message}");
        }
        finally
        {
            isCrawling = false;
        }
    }

    private async Task CrawlRssFeeds()
    {
        isCrawling = true;
        crawlSummary = null;
        StateHasChanged();

        try
        {
            crawlSummary = await AppService.CrawlNzbRssFeedsForShow(show.Id);
        }
        catch (Exception ex)
        {
            crawlSummary = new NzbSiteCrawlSummary();
            crawlSummary.Errors.Add($"RSS crawl failed: {ex.Message}");
        }
        finally
        {
            isCrawling = false;
        }
    }

    private async Task AddAlias()
    {
        if (!string.IsNullOrWhiteSpace(newAliasName))
        {
            await AppService.AddFolderAlias(show.Id, newAliasName);
            newAliasName = "";
            showAliasInput = false;
            folderAliases = AppService.GetFolderAliases(show.Id);
        }
    }

    private async Task RemoveAlias(int aliasId)
    {
        await AppService.RemoveFolderAlias(aliasId);
        folderAliases = AppService.GetFolderAliases(show.Id);
    }
}
