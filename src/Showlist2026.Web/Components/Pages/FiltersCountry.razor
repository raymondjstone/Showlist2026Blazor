@page "/filters/countries"
@rendermode InteractiveServer
@inject IShowListAppService AppService

<PageTitle>Country Filters</PageTitle>

@if (countries == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <h4>Country Filters</h4>
        <br />
        @foreach (var i in countries)
        {
            <div class="row mb-1">
                <div class="col-4">
                    @i.name
                </div>
                <div class="col-2">
                    @i.code
                </div>
                @if (i.UserCountrySelections == null || i.UserCountrySelections.Count == 0)
                {
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always include show if the country is @i.name"
                                @onclick="() => SetFilter(i.Id, true)">
                            Always Include
                        </button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always exclude show if the country is @i.name"
                                @onclick="() => SetFilter(i.Id, false)">
                            Always Exclude
                        </button>
                    </div>
                }
                else if (i.UserCountrySelections.First().include)
                {
                    <div class="col-3">
                        <button class="btn btn-success btn-sm" title="Click to remove the always included filter"
                                @onclick="() => DeleteFilter(i.Id)">
                            Always included
                        </button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always exclude show if the country is @i.name"
                                @onclick="() => SetFilter(i.Id, false)">
                            Always Exclude
                        </button>
                    </div>
                }
                else
                {
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always include show if the country is @i.name"
                                @onclick="() => SetFilter(i.Id, true)">
                            Always Include
                        </button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-danger btn-sm" title="Click to remove the always excluded filter"
                                @onclick="() => DeleteFilter(i.Id)">
                            Always Excluded
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Country> countries;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        countries = AppService.CountryData().OrderBy(a => a.name).ToList();
    }

    private async Task SetFilter(int id, bool stateWanted)
    {
        await AppService.CountryFilter(id, stateWanted);
        await LoadData();
    }

    private async Task DeleteFilter(int id)
    {
        await AppService.CountryFilter(id, null);
        await LoadData();
    }
}
