@page "/filters/genres"
@rendermode InteractiveServer
@inject IShowListAppService AppService

<PageTitle>Genre Filters</PageTitle>

@if (genres == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <h4>Genre Filters</h4>
        <br />
        @foreach (var i in genres)
        {
            <div class="row mb-1">
                <div class="col-4">
                    @i.genre
                    @if (string.IsNullOrEmpty(i.genre))
                    {
                        <text>{No genre specified}</text>
                    }
                </div>
                @if (i.Wanted == null)
                {
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always include show if the genre is @i.genre"
                                @onclick="() => SetFilter(i.Id, true)">
                            Always Include
                        </button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always exclude show if the genre is @i.genre"
                                @onclick="() => SetFilter(i.Id, false)">
                            Always Exclude
                        </button>
                    </div>
                }
                else if (i.Wanted == true)
                {
                    <div class="col-3">
                        <button class="btn btn-success btn-sm" title="Click to remove the always included filter"
                                @onclick="() => DeleteFilter(i.Id)">
                            Always included
                        </button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always exclude show if the genre is @i.genre"
                                @onclick="() => SetFilter(i.Id, false)">
                            Always Exclude
                        </button>
                    </div>
                }
                else
                {
                    <div class="col-3">
                        <button class="btn btn-outline-secondary btn-sm" title="Always include show if the genre is @i.genre"
                                @onclick="() => SetFilter(i.Id, true)">
                            Always Include
                        </button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-danger btn-sm" title="Click to remove the always excluded filter"
                                @onclick="() => DeleteFilter(i.Id)">
                            Always Excluded
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<GenreText> genres;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        genres = AppService.GenreData().OrderBy(a => a.genre).ToList();
    }

    private async Task SetFilter(int id, bool stateWanted)
    {
        await AppService.GenreFilter(id, stateWanted);
        await LoadData();
    }

    private async Task DeleteFilter(int id)
    {
        await AppService.GenreFilter(id, null);
        await LoadData();
    }
}
